/* Setel true bila nomor HP PIC boleh tampil penuh di halaman publik. */
const TAMPILKAN_NOMOR_PIC = false;

const state = { all: [], view: [], fetchedAt: null, sort: { key: 'no', dir: 'asc' } };

/* ---------------- format ---------------- */
const fmt = (n) => (n === null || n === undefined || !Number.isFinite(n))
  ? '—' : new Intl.NumberFormat('id-ID').format(Math.round(n));

const fmtRp = (n) => {
  if (!Number.isFinite(n) || !n) return '—';
  if (n >= 1e9) return 'Rp ' + (n / 1e9).toFixed(2).replace('.', ',') + ' M';
  if (n >= 1e6) return 'Rp ' + (n / 1e6).toFixed(1).replace('.', ',') + ' Jt';
  return 'Rp ' + fmt(n);
};
const fmtRpFull = (n) => (!Number.isFinite(n) || !n) ? '—' : 'Rp ' + fmt(n);
const esc = (s) => String(s == null ? '' : s)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const pctOf = (n, t) => t ? Math.round((n / t) * 100) : 0;

function maskPic(pic) {
  if (!pic) return '';
  if (TAMPILKAN_NOMOR_PIC) return pic;
  return pic.replace(/(\+?62|0)\s?8[\d\s\-.]{7,14}\d/g, '•••••••• (lihat sheet)');
}

