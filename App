  'Proses Awal':          { c: '#0EA5E9', sym: '◔' },
  'Penilaian / Survei':   { c: '#1B62D6', sym: '◑' },
  'Penyusunan Kontrak':   { c: '#F59E0B', sym: '◕' },
  'Penandatanganan':      { c: '#7C3AED', sym: '✎' },
