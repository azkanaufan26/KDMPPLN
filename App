  renderStatList('list-progres', 'progresNorm', URUT_PROGRES, PROGRES, null, disetujui);

  document.getElementById('callout-progres').innerHTML = disetujui.length
    ? `<div class="callout${terisi.length ? '' : ' warn'}">${
        terisi.length
          ? `${fmt(terisi.length)} dari ${fmt(disetujui.length)} permohonan disetujui sudah ditindaklanjuti secara kontraktual.`
          : `Menunggu pengisian: ${fmt(disetujui.length)} permohonan sudah disetujui namun belum ada satu pun laporan progres kontrak dari unit.`
      }</div>`
    : '';

  const belum = agg(disetujui.filter((r) => r.progresNorm === 'Belum Diisi'), 'unit');
  renderRankList('list-belum-progres', belum, {
    limit: 12, color: '#F59E0B',
    emptyText: disetujui.length
      ? 'Seluruh permohonan yang disetujui sudah punya progres kontrak.'
      : 'Belum ada permohonan yang disetujui pada filter ini.'
  });
}

/* ---------------- tabel ---------------- */
function sortRows(rows) {
  const { key, dir } = state.sort, mul = dir === 'asc' ? 1 : -1;
  return [...rows].sort((a, b) => {
    const av = a[key], bv = b[key];
    const an = av === null || av === undefined || av === '';
    const bn = bv === null || bv === undefined || bv === '';
    if (an && bn) return 0;
    if (an) return 1;
    if (bn) return -1;
    if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * mul;
    return String(av).localeCompare(String(bv), 'id') * mul;
  });
}

const tag = (text, meta) => `<span class="tag ${meta ? meta.tag : 't-none'}">${esc(text)}</span>`;

function renderTable() {
  const rows = sortRows(state.view);
  document.getElementById('tcount').textContent =
    `${fmt(rows.length)} dari ${fmt(state.all.length)} permohonan`;
  const tb = document.getElementById('tbody');

  if (!rows.length) {
    tb.innerHTML = `<tr><td colspan="10"><div class="empty">Tidak ada permohonan yang cocok dengan filter.</div></td></tr>`;
    return;
  }

  tb.innerHTML = rows.map((r) => `
    <tr data-no="${r.no}">
      <td class="num">${r.no}</td>
      <td class="unm"><div class="wrap2">${esc(r.pemohon || '—')}</div></td>
      <td><div class="wrap2">${esc(r.lokasi || '—')}</div></td>
      <td>${esc(r.kota)}</td>
      <td><span class="gpill">${esc(r.unit)}</span></td>
      <td class="num">${r.luasDiminta ? fmt(r.luasDiminta) : '—'}</td>
      <td>${esc(r.jenisSertipikat || '—')}</td>
      <td>${tag(r.statusAset, STATUS_ASET[r.statusAset])}</td>
      <td>${tag(r.persetujuan, PERSETUJUAN[r.persetujuan])}</td>
      <td>${r.progresKontrak ? esc(r.progresKontrak) : '<span style="color:var(--teks-3)">belum diisi</span>'}</td>
    </tr>`).join('');

  tb.querySelectorAll('tr').forEach((tr) =>
    tr.addEventListener('click', () => openModal(Number(tr.dataset.no))));
}

function bindSorting() {
  document.querySelectorAll('#tbl thead th').forEach((th) => {
    th.addEventListener('click', () => {
      const key = th.dataset.sort;
      if (!key) return;
      state.sort.dir = (state.sort.key === key && state.sort.dir === 'asc') ? 'desc' : 'asc';
      state.sort.key = key;
      document.querySelectorAll('#tbl thead th').forEach((o) => {
        o.classList.remove('sorted');
        const a = o.querySelector('.ar'); if (a) a.textContent = '↕';
      });
      th.classList.add('sorted');
      th.querySelector('.ar').textContent = state.sort.dir === 'asc' ? '↑' : '↓';
      renderTable();
    });
  });
}

/* ---------------- modal ---------------- */
const linkOrText = (v) => !v ? '—'
  : (/^https?:\/\//i.test(v) ? `<a href="${esc(v)}" target="_blank" rel="noopener">Buka tautan ↗</a>` : esc(v));

function openModal(no) {
  const r = state.all.find((x) => x.no === no);
  if (!r) return;
  document.getElementById('modal-title').textContent = r.pemohon || `Permohonan No. ${r.no}`;
  document.getElementById('modal-sub').textContent = `No. ${r.no} · ${r.unitRaw || r.unit} · ${r.kota}`;

  const f = [
    ['Satuan / Instansi Pengusul', esc(r.satuan || '—')],
    ['Lokasi Aset', esc(r.lokasi || '—')],
    ['Desa / Kelurahan', esc(r.desa || '—')],
    ['Kota / Kabupaten', esc(r.kota || '—')],
    ['Unit Pemilik Aset', esc(r.unitRaw || r.unit)],
    ['Kelompok Unit', esc(r.kelompok)],
    ['Link Google Maps', linkOrText(r.maps)],
    ['Koordinat', esc(r.koordinat || '—')],
    ['Luas Sesuai Sertipikat', r.luasSertifikat ? fmt(r.luasSertifikat) + ' m²' : '—'],
    ['Luas Lahan Diminta', r.luasDiminta ? fmt(r.luasDiminta) + ' m²' : '—'],
    ['Jenis Sertipikat', esc(r.jenisSertipikat || '—')],
    ['Nomor Sertipikat', esc(r.nomorSertipikat || '—')],
    ['Status Aset', esc(r.statusAsetRaw || r.statusAset)],
    ['Rencana Pemanfaatan', esc(r.rencana || '—')],
    ['Surat Permohonan Pemda', linkOrText(r.suratPemda)],
    ['Status Komunikasi', esc(r.statusKomunikasi || '—')],
    ['Keterangan', esc(r.keterangan || '—')],
    ['Nilai Aset per m²', fmtRpFull(r.nilaiPerM2)],
    ['Estimasi Nilai Sewa', fmtRpFull(r.estimasiSewa)],
    ['PIC BUMN di Daerah', esc(maskPic(r.pic) || '—')],
    ['Persetujuan Tindak Lanjut', esc(r.persetujuanRaw || r.persetujuan)],
    ['Progres Kontrak', esc(r.progresKontrak || 'belum diisi')]
  ];
  document.getElementById('modal-dl').innerHTML = f.map(([k, v]) => `<dt>${esc(k)}</dt><dd>${v}</dd>`).join('');
  document.getElementById('modal').classList.add('on');
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  document.getElementById('modal').classList.remove('on');
  document.body.style.overflow = '';
}

/* ---------------- analisis otomatis ---------------- */
function renderAnalisis() {
  const rows = state.view, total = rows.length;
  const el = document.getElementById('anal-narasi');
  if (!total) {
    el.innerHTML = '<p>Tidak ada permohonan pada filter yang aktif.</p>';
    document.getElementById('anal-metrik').innerHTML = '';
    document.getElementById('anal-perhatian').innerHTML = '';
    return;
  }

  const dis = rows.filter((r) => r.persetujuan === 'Disetujui');
  const tol = rows.filter((r) => r.persetujuan === 'Tidak Disetujui');
  const pro = rows.filter((r) => r.persetujuan === 'Menunggu Konfirmasi' || r.persetujuan === 'Belum Ada Keputusan');
  const idle = rows.filter((r) => r.statusAset.startsWith('IDLE'));
  const luas = rows.reduce((a, r) => a + (r.luasDiminta || 0), 0);
  const sewa = rows.reduce((a, r) => a + (r.estimasiSewa || 0), 0);
  const luasIsi = rows.filter((r) => r.luasDiminta).length;
  const perUnit = agg(rows, 'unit');
  const perKota = agg(rows, 'kota');
  const tanpaSertipikat = rows.filter((r) => !r.nomorSertipikat || r.nomorSertipikat === '-').length;
  const tanpaLuas = total - luasIsi;
  const tanpaSewa = rows.filter((r) => !r.estimasiSewa).length;
  const belumKontrak = rows.filter((r) => !r.progresKontrak).length;
  const rerataLuas = luasIsi ? luas / luasIsi : 0;

  el.innerHTML = `
    <h3>Gambaran Umum</h3>
    <p>Terdapat <b>${fmt(total)} permohonan</b> pemanfaatan lahan PLN oleh Koperasi Desa/Kelurahan Merah Putih
       yang tersebar di <b>${fmt(perKota.length)} kota/kabupaten</b> dan melibatkan
       <b>${fmt(perUnit.length)} unit pemilik aset</b>. Total luas lahan yang dimohon mencapai
       <b>${fmt(luas)} m²</b> dari ${fmt(luasIsi)} permohonan yang sudah mencantumkan luas
       (rata-rata ${fmt(rerataLuas)} m² per permohonan).</p>

    <h3>Posisi Keputusan</h3>
    <p>Sebanyak <b>${fmt(dis.length)} permohonan (${pctOf(dis.length, total)}%)</b> telah disetujui untuk
       ditindaklanjuti, <b>${fmt(pro.length)} permohonan (${pctOf(pro.length, total)}%)</b> masih dalam proses
       menunggu konfirmasi lahan atau belum diputus, dan <b>${fmt(tol.length)} permohonan
       (${pctOf(tol.length, total)}%)</b> tidak disetujui. ${
      tol.length
        ? `Penolakan umumnya terkait lahan yang masih produktif atau mengganggu kegiatan operasional PLN.`
        : `Belum ada permohonan yang ditolak pada cakupan filter ini.`}</p>

    <h3>Kondisi Aset</h3>
    <p><b>${fmt(idle.length)} dari ${fmt(total)} permohonan (${pctOf(idle.length, total)}%)</b> mengarah pada
       lahan berstatus IDLE, sehingga pemanfaatan oleh koperasi berpotensi mengoptimalkan aset yang belum
       produktif. Estimasi nilai sewa yang sudah terhitung mencapai <b>${fmtRp(sewa)}</b>
       dari ${fmt(total - tanpaSewa)} permohonan; sisanya belum dinilai.</p>

    <h3>Konsentrasi Permohonan</h3>
    <p>Unit dengan permohonan terbanyak adalah <b>${esc(perUnit[0][0])}</b> (${fmt(perUnit[0][1])} permohonan)${
      perUnit[1] ? `, diikuti <b>${esc(perUnit[1][0])}</b> (${fmt(perUnit[1][1])})` : ''}${
      perUnit[2] ? ` dan <b>${esc(perUnit[2][0])}</b> (${fmt(perUnit[2][1])})` : ''}.
       Secara wilayah, <b>${esc(perKota[0][0])}</b> menjadi daerah dengan permohonan terbanyak
       (${fmt(perKota[0][1])} titik lahan).</p>

    <h3>Kelengkapan Data</h3>
    <p>Kolom progres kontrak masih kosong pada <b>${fmt(belumKontrak)} dari ${fmt(total)} baris</b>,
       luas lahan belum terisi pada <b>${fmt(tanpaLuas)} baris</b>, dan nomor sertipikat belum tersedia
       pada <b>${fmt(tanpaSertipikat)} baris</b>. Kelengkapan ini perlu dilengkapi agar monitoring
       tindak lanjut kontraktual dapat berjalan.</p>`;

  document.getElementById('anal-metrik').innerHTML = [
    { k: 'Tingkat Persetujuan', v: pctOf(dis.length, total) + '%', s: `${fmt(dis.length)} dari ${fmt(total)} permohonan` },
    { k: 'Lahan IDLE', v: pctOf(idle.length, total) + '%', s: `${fmt(idle.length)} permohonan atas lahan idle` },
    { k: 'Rata-rata Luas Diminta', v: fmt(rerataLuas) + ' m²', s: `dari ${fmt(luasIsi)} baris terisi` },
    { k: 'Estimasi Nilai Sewa', v: fmtRp(sewa), s: `${fmt(total - tanpaSewa)} baris sudah dinilai` }
  ].map((m) => `<div><p class="k">${esc(m.k)}</p><p class="v">${m.v}</p><p class="s">${esc(m.s)}</p></div>`).join('');

  const perhatian = [];
  if (belumKontrak) perhatian.push(`Progres kontrak belum terisi pada <b>${fmt(belumKontrak)} permohonan</b> — termasuk ${fmt(dis.length)} yang sudah disetujui.`);
  if (tanpaLuas) perhatian.push(`<b>${fmt(tanpaLuas)} permohonan</b> belum mencantumkan luas lahan yang diminta.`);
  if (tanpaSertipikat) perhatian.push(`<b>${fmt(tanpaSertipikat)} permohonan</b> belum memiliki nomor sertipikat/alas hak yang jelas.`);
  if (pro.length) perhatian.push(`<b>${fmt(pro.length)} permohonan</b> masih menunggu konfirmasi kepemilikan lahan dan perlu percepatan.`);
  const nonPln = rows.filter((r) => /bukan m?ilik pln|tidak memiliki alas hak/i.test(r.keterangan || '')).length;
  if (nonPln) perhatian.push(`<b>${fmt(nonPln)} permohonan</b> menyangkut lahan yang diindikasikan bukan milik PLN atau tanpa alas hak.`);
  if (!perhatian.length) perhatian.push('Tidak ada butir perhatian pada cakupan filter ini.');

  document.getElementById('anal-perhatian').innerHTML =
    perhatian.map((p) => `<li><span class="bul">›</span><span>${p}</span></li>`).join('');
}

/* ---------------- ekspor CSV ---------------- */
function exportCsv() {
  const head = ['No', 'Satuan/Instansi', 'Pihak Pemohon', 'Lokasi Aset', 'Desa/Kelurahan', 'Kota/Kab',
    'Unit Pemilik Aset', 'Kelompok', 'Luas Sertipikat (m2)', 'Luas Diminta (m2)', 'Jenis Sertipikat',
    'Nomor Sertipikat', 'Status Aset', 'Rencana Pemanfaatan', 'Status Komunikasi', 'Keterangan',
    'Nilai per m2', 'Estimasi Sewa', 'Persetujuan', 'Progres Kontrak'];
  const q = (v) => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
  const lines = [head.map(q).join(';')];
  sortRows(state.view).forEach((r) => lines.push([r.no, r.satuan, r.pemohon, r.lokasi, r.desa, r.kota,
    r.unitRaw, r.kelompok, r.luasSertifikat ?? '', r.luasDiminta ?? '', r.jenisSertipikat, r.nomorSertipikat,
    r.statusAsetRaw, r.rencana, r.statusKomunikasi, r.keterangan, r.nilaiPerM2 ?? '', r.estimasiSewa ?? '',
    r.persetujuanRaw, r.progresKontrak].map(q).join(';')));
  const blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `kdmp-permohonan-${new Date().toISOString().slice(0, 10)}.csv`;
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

/* ---------------- render menyeluruh ---------------- */
function renderAll() {
  const rows = state.view;
  renderKpis();
  renderStatList('list-persetujuan', 'persetujuan', URUT_PERSETUJUAN, PERSETUJUAN);
  renderStatList('list-status', 'statusAset', URUT_STATUS_ASET, STATUS_ASET);
  renderStatList('list-sertipikat', 'jenisSertipikatNorm', null, null);
  renderStatList('list-komunikasi', 'komunikasiNorm', null, null);

  const dis = rows.filter((r) => r.persetujuan === 'Disetujui').length;
  document.getElementById('callout-persetujuan').innerHTML = rows.length
    ? `<div class="callout${dis / rows.length < 0.5 ? ' warn' : ''}">${fmt(dis)} dari ${fmt(rows.length)} permohonan (${pctOf(dis, rows.length)}%) sudah mendapat persetujuan tindak lanjut.</div>`
    : '';

  renderProgres();
  renderRankList('list-unit', agg(rows, 'unit'), { limit: 12, color: 'var(--navy)' });
  renderRankList('list-kota', agg(rows, 'kota'), { limit: 10, color: '#1B62D6' });
  svgBar('chart-luas', agg(rows, 'unit', (r) => r.luasDiminta), { limit: 12, color: '#F59E0B', unit: 'm²' });

  renderTable();
  renderAnalisis();
}

/* ---------------- routing ---------------- */
function route() {
  const hash = (location.hash || '#dashboard').slice(1);
  const valid = ['dashboard', 'data', 'analisis', 'cetak'];
  const r = valid.includes(hash) ? hash : 'dashboard';
  document.querySelectorAll('[data-view]').forEach((el) => el.classList.toggle('on', el.dataset.view === r));
  document.querySelectorAll('#nav a').forEach((a) => a.classList.toggle('on', a.dataset.route === r));
  document.getElementById('filters').hidden = (r === 'cetak');
  window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
}

/* ---------------- muat data ---------------- */
async function load() {
  const bar = document.getElementById('livebar');
  const txt = document.getElementById('live-text');
  bar.className = 'livebar loading';
  bar.querySelector('.dot').className = 'dot loading';
  txt.textContent = 'Menarik data langsung dari Google Sheets…';

  try {
    const { rows, fetchedAt } = await window.KDMP.fetchKdmpData();
    state.all = rows;
    state.fetchedAt = fetchedAt;
    buildFilterOptions();
    applyFilters();
    bar.className = 'livebar ok';
    bar.querySelector('.dot').className = 'dot ok';
    txt.textContent = `Data berhasil dimuat langsung dari Google Sheets — ${fmt(rows.length)} permohonan.`;
    document.getElementById('upd-time').innerHTML =
      'Diperbarui: <b>' + fetchedAt.toLocaleString('id-ID', { dateStyle: 'long', timeStyle: 'short' }) + '</b>';
  } catch (err) {
    bar.className = 'livebar bad';
    bar.querySelector('.dot').className = 'dot bad';
    txt.textContent = 'Gagal memuat data: ' + err.message +
      ' — pastikan sheet dibagikan "Anyone with the link — Viewer".';
    document.getElementById('upd-time').textContent = 'Data gagal dimuat';
  }
}

/* ---------------- init ---------------- */
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('link-sheet').href = window.KDMP.KDMP_SHEET_URL;
  ['f-kelompok', 'f-unit', 'f-persetujuan', 'f-status'].forEach((id) =>
    document.getElementById(id).addEventListener('change', applyFilters));
  let t;
  document.getElementById('f-search').addEventListener('input', () => {
    clearTimeout(t); t = setTimeout(applyFilters, 180);
  });
  document.getElementById('reset').addEventListener('click', () => {
    ['f-kelompok', 'f-unit', 'f-persetujuan', 'f-status'].forEach((id) => (document.getElementById(id).value = ''));
    document.getElementById('f-search').value = '';
    applyFilters();
  });
  document.getElementById('btn-refresh').addEventListener('click', load);
  document.getElementById('btn-export').addEventListener('click', exportCsv);
  document.getElementById('btn-print').addEventListener('click', () => window.print());
  document.getElementById('modal-close').addEventListener('click', closeModal);
  document.getElementById('modal').addEventListener('click', (e) => { if (e.target.id === 'modal') closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  window.addEventListener('hashchange', route);
  bindSorting();
  route();
  load();
});
