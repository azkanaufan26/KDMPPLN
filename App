    {
      ic: ikon('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>', '#FFF7E6', '#F59E0B'),
      lbl: 'Dalam Proses', big: fmt(pro), bigColor: 'var(--oranye)',
      cap: 'Menunggu konfirmasi lahan / belum diputus'
