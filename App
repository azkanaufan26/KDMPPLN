}

/* ---------------- daftar status ---------------- */
function renderStatList(elId, key, urutan, kamus, fallbackPalette, rowsOverride) {
  const rows = rowsOverride || state.view, total = rows.length || 1;
  const counts = {};
  rows.forEach((r) => { const k = r[key] || 'Belum Diisi'; counts[k] = (counts[k] || 0) + 1; });
  let keys = urutan ? urutan.filter((k) => counts[k]) : [];
  keys = keys.concat(Object.keys(counts).filter((k) => !keys.includes(k)).sort((a, b) => counts[b] - counts[a]));
  const max = Math.max(1, ...keys.map((k) => counts[k]));

  const el = document.getElementById(elId);
  if (!keys.length) { el.innerHTML = '<li style="color:var(--teks-2)">Tidak ada data pada filter ini.</li>'; return; }

  el.innerHTML = keys.map((k, i) => {
    const meta = (kamus && kamus[k]) || { c: (fallbackPalette || PALET)[i % 8], sym: '•' };
    const n = counts[k];
    return `<li title="${esc(k)}">
      <span class="sym" style="color:${meta.c}">${meta.sym}</span>
      <span class="nm">${esc(k)}</span>
      <span class="br"><i style="width:${(n / max) * 100}%;background:${meta.c}"></i></span>
      <b>${fmt(n)}</b><span class="pct">${pctOf(n, total)}%</span>
    </li>`;
  }).join('');
}

/* ---------------- daftar peringkat ---------------- */
function renderRankList(elId, entries, opts = {}) {
  const el = document.getElementById(elId);
  const { limit = 12, color = 'var(--navy)', suffix = '', emptyText = 'Tidak ada data pada filter ini.' } = opts;
  const data = entries.slice(0, limit);
  if (!data.length) { el.innerHTML = `<li style="color:var(--teks-2)">${esc(emptyText)}</li>`; return; }
  const max = Math.max(...data.map((e) => e[1]));
  el.innerHTML = data.map((e, i) => `
    <li title="${esc(e[0])}">
      <span class="no">${i + 1}</span>
      <span class="nm">${esc(e[0])}</span>
      <span class="br"><i style="width:${(e[1] / max) * 100}%;background:${color}"></i></span>
      <b>${fmt(e[1])}${suffix ? ` <small>${suffix}</small>` : ''}</b>
    </li>`).join('');
}

/* ---------------- chart SVG batang horizontal ---------------- */
function svgBar(elId, entries, { limit = 10, color = '#1B62D6', unit = '' } = {}) {
  const el = document.getElementById(elId);
  const data = entries.slice(0, limit);
  if (!data.length) { el.innerHTML = '<p style="color:var(--teks-2);font-size:12px">Tidak ada data pada filter ini.</p>'; return; }

  const rowH = 24, padT = 8, padB = 24, labelW = 168, plotW = 420;
  const h = padT + data.length * rowH + padB;
  const w = labelW + plotW + 58;
  const max = Math.max(...data.map((e) => e[1]));
  const ticks = 4;

  let s = `<svg class="chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="Grafik batang">`;
  // gridline
  for (let t = 0; t <= ticks; t++) {
    const x = labelW + (plotW * t) / ticks;
    s += `<line x1="${x}" y1="${padT}" x2="${x}" y2="${padT + data.length * rowH}" stroke="#E5EAF1" stroke-width="1"/>`;
    s += `<text x="${x}" y="${h - 8}" font-size="9.5" fill="#94A3B8" text-anchor="middle">${fmt((max * t) / ticks)}</text>`;
  }
  data.forEach((e, i) => {
    const y = padT + i * rowH;
    const bw = Math.max(2, (e[1] / max) * plotW);
    const nm = e[0].length > 26 ? e[0].slice(0, 25) + '…' : e[0];
    s += `<text x="${labelW - 8}" y="${y + 15}" font-size="10.5" fill="#334155" text-anchor="end">${esc(nm)}</text>`;
    s += `<rect x="${labelW}" y="${y + 5}" width="${bw}" height="12" rx="3" fill="${color}"><title>${esc(e[0])}: ${fmt(e[1])} ${unit}</title></rect>`;
    s += `<text x="${labelW + bw + 6}" y="${y + 15}" font-size="10" font-weight="700" fill="#0F172A">${fmt(e[1])}</text>`;
  });
  s += `<line x1="${labelW}" y1="${padT}" x2="${labelW}" y2="${padT + data.length * rowH}" stroke="#CBD5E1" stroke-width="1"/>`;
  s += `<text x="${labelW + plotW / 2}" y="${h - 8}" font-size="9.5" fill="#94A3B8" text-anchor="middle" opacity="0"></text>`;
  s += '</svg>';
  el.innerHTML = s;
}

