const PALET = ['#1B62D6', '#F59E0B', '#16A34A', '#7C3AED', '#0EA5E9', '#DC2626', '#64748B', '#94A3B8'];

/* ---------------- filter ---------------- */
function applyFilters() {
  const g = (id) => document.getElementById(id).value;
  const q = document.getElementById('f-search').value.trim().toLowerCase();
  const kel = g('f-kelompok'), unit = g('f-unit'), per = g('f-persetujuan'), sta = g('f-status');

  state.view = state.all.filter((r) => {
    if (kel && r.kelompok !== kel) return false;
    if (unit && r.unit !== unit) return false;
    if (per && r.persetujuan !== per) return false;
    if (sta && r.statusAset !== sta) return false;
    if (q) {
      const hay = [r.pemohon, r.satuan, r.lokasi, r.kota, r.desa, r.unit, r.rencana, r.keterangan, r.nomorSertipikat]
        .join(' ').toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });
  renderAll();
}

function fillSelect(id, values) {
  const sel = document.getElementById(id);
  const prev = sel.value;
  const first = sel.querySelector('option').outerHTML;
  sel.innerHTML = first + values.map((v) => `<option value="${esc(v)}">${esc(v)}</option>`).join('');
  if (prev && values.includes(prev)) sel.value = prev;
}

function buildFilterOptions() {
  const uniq = (key, order) => {
    const set = [...new Set(state.all.map((r) => r[key]).filter(Boolean))];
    return order
      ? order.filter((o) => set.includes(o)).concat(set.filter((s) => !order.includes(s)))
      : set.sort((a, b) => a.localeCompare(b, 'id'));
  };
  fillSelect('f-kelompok', uniq('kelompok'));
  fillSelect('f-unit', uniq('unit'));
  fillSelect('f-persetujuan', uniq('persetujuan', URUT_PERSETUJUAN));
  fillSelect('f-status', uniq('statusAset', URUT_STATUS_ASET));
}

/* ---------------- agregasi ---------------- */
function agg(rows, key, valueFn) {
  const m = new Map();
  rows.forEach((r) => {
    const k = (r[key] || '—');
    m.set(k, (m.get(k) || 0) + (valueFn ? (valueFn(r) || 0) : 1));
  });
  return [...m.entries()].filter(([, v]) => v > 0).sort((a, b) => b[1] - a[1]);
}

/* ---------------- KPI ---------------- */
function ikon(path, bg, stroke) {
  return `<div class="ic" style="background:${bg}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${stroke}" stroke-width="2.2"
      stroke-linecap="round" stroke-linejoin="round">${path}</svg></div>`;
}

