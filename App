    {
      ic: ikon('<circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/>', '#FEF2F2', '#DC2626'),
      lbl: 'Tidak Disetujui', big: fmt(tol), bigColor: 'var(--merah)',
