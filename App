  document.getElementById('progres-hero').innerHTML = `
    <div class="phero">
      <span class="pv" style="color:${terisi.length ? 'var(--navy)' : 'var(--teks-3)'}">${fmt(terisi.length)} / ${fmt(disetujui.length)}</span>
      <span class="pd">permohonan disetujui sudah punya progres kontrak</span>
    </div>
    <div class="pbar${terisi.length ? '' : ' kosong'}">
      <i style="width:${persen}%;background:${tuntas ? '#16A34A' : '#1B62D6'}"></i>
    </div>
