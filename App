function renderProgres() {
  const rows = state.view;
  const disetujui = rows.filter((r) => r.persetujuan === 'Disetujui');
  const terisi = disetujui.filter((r) => r.progresNorm !== 'Belum Diisi');
  const kosong = disetujui.length - terisi.length;
  const persen = pctOf(terisi.length, disetujui.length);
